{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": ["vite/client", "node"],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["client", "shared", "tests", "server"]
}
