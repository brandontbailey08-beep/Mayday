{
  "name": "mayday-flight-404",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT \"tsx watch server/index.ts\" \"vite --config client/vite.config.ts\"",
    "build": "npm run typecheck && vite build --config client/vite.config.ts && tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "start": "node dist/server/index.js",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/autopilot.test.js .test-build/tests/simulation.test.js .test-build/tests/rooms.test.js .test-build/tests/network.test.js .test-build/tests/bots-tutorial.test.js",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@babylonjs/core": "^9.0.0",
    "express": "^5.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.0",
    "concurrently": "^9.1.2",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
